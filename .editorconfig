# Use case: Keeps whitespace and encoding consistent across editors and languages.
# What it does: Applies UTF-8, final newlines, trimmed whitespace, and project indentation defaults.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

